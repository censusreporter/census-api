[packages]
boto3 = "*"
openpyxl = "*"
psycopg2-binary = "*"
Flask = "3.0.3"
Werkzeug = "*" # https://stackoverflow.com/a/77214086/102476
# SQLAlchemy 1.4.x introduced a regression with flask-sqlalchemy
# https://github.com/pallets/flask-sqlalchemy/issues/971
# Keep pinned at 1.3.21
# and flask-sqlalchemy at the compatible 2.5.1
SQLAlchemy = "2.0.36"
flask-sqlalchemy = "3.1.1"
flask-cors = "*"
flask-caching = "*"
# Pinned: the deployed Redis server is v5.0.7 (pre-6.0), which doesn't support
# the HELLO command or ACL-style `AUTH user pass`. redis-py >= 6 tries HELLO
# by default when a username is present in REDIS_URL (ours has one) and fails
# outright rather than falling back. Don't unpin this without also upgrading
# the Redis server.
redis = "==5.1.1"
gunicorn = "*"
celery = "*"
pandas = "*"
# Must exactly match the gdal-bin/libgdal-dev version apt installs from the
# Dockerfile's pinned base image (python:3.11-trixie -> gdal-config 3.10.3).
# If you bump the base image's Debian codename, re-check `gdal-config --version`
# in that image and update this pin to match, or the build will fail.
gdal = "==3.10.3"
requests = "*"

[requires]
python_version = "3.11"
